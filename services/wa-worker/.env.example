# === Flowyn WhatsApp Worker ===

# Supabase (pooler connection)
DATABASE_URL="postgresql://postgres.NOME:SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Flowyn API (Vercel) - para webhooks
FLOWYN_API_URL="https://seu-app.vercel.app"
FLOWYN_WEBHOOK_SECRET="gere-um-secret-seguro"

# Redis (opcional, para fila de mensagens)
REDIS_URL="redis://localhost:6379"

# Porta do servidor HTTP
PORT=3001

# Nível de log
LOG_LEVEL="info"
